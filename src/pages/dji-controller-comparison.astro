            <p class="mt-4 text-lg opacity-80">RC Plus · RC 2 · RC Pro 2 운용 가이드</p>
        </section>
        <section>
            <Markdown content={overviewContent} />
        </section>
        <section>
            <Markdown content={inspire3ConfigContent} />
        </section>
        <section>
            <Markdown content={checklistContent} />
        </section>
        <section>
            <Markdown content={comparisonContent} />
        </section>
    </div>
</Layout>
